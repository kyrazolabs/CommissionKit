# Stage 1: Build Next.js
FROM oven/bun:1.3.13-alpine AS builder

WORKDIR /app

# Copy dependency files first to cache the bun install layer
COPY package.json bun.lock ./
COPY tsconfig.base.json ./
COPY scripts/package.json ./scripts/
COPY artifacts/api/package.json ./artifacts/api/
COPY artifacts/web/package.json ./artifacts/web/
COPY artifacts/blog/package.json ./artifacts/blog/
COPY lib/db/package.json ./lib/db/
COPY lib/queue/package.json ./lib/queue/
COPY lib/email-templates/package.json ./lib/email-templates/
COPY lib/api-zod/package.json ./lib/api-zod/
COPY lib/api-client-react/package.json ./lib/api-client-react/
COPY lib/api-spec/package.json ./lib/api-spec/
COPY plugins/core/package.json ./plugins/core/
COPY plugins/custom/package.json ./plugins/custom/
COPY plugins/odoo/package.json ./plugins/odoo/
COPY plugins/hubspot/package.json ./plugins/hubspot/
COPY plugins/salesforce/package.json ./plugins/salesforce/

# Copy blog workspace configs
COPY artifacts/blog/tsconfig.json artifacts/blog/
COPY artifacts/blog/next.config.ts artifacts/blog/
COPY artifacts/blog/postcss.config.mjs artifacts/blog/

# Copy source and articles
COPY artifacts/blog/src artifacts/blog/src/
COPY artifacts/blog/public artifacts/blog/public/
COPY artifacts/blog/articles artifacts/blog/articles/

# Install dependencies and build
RUN bun install --frozen-lockfile
WORKDIR /app/artifacts/blog
RUN bun run build

# Stage 2: Production — Next.js standalone server
FROM oven/bun:1.3.13-alpine

WORKDIR /app

# Copy built standalone output
COPY --from=builder /app/artifacts/blog/.next/standalone ./
COPY --from=builder /app/artifacts/blog/.next/static ./artifacts/blog/.next/static
COPY --from=builder /app/artifacts/blog/public ./artifacts/blog/public
COPY --from=builder /app/artifacts/blog/articles ./articles

ENV NODE_ENV=production
ENV PORT=3000
EXPOSE 3000

CMD ["bun", "run", "artifacts/blog/server.js"]
