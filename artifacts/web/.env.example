# ─── i18n ─────────────────────────────────────────────────────────────────────
# Supported languages: en (English), es (Spanish)
# Language is auto-detected from browser preferences and stored in localStorage.
# Users can switch language via the globe icon in the header.

# ─── API ──────────────────────────────────────────────────────────────────────
# URL of the backend API (no trailing slash)
# Development: http://localhost:8088
# Production:  https://api.yourdomain.com
VITE_API_URL=http://localhost:8088

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Must match BETTER_AUTH_URL in the API .env
VITE_BETTER_AUTH_URL=http://localhost:8088

# ─── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_STARTER_PRICE_ID=price_... # $49/mo - 10 reps
STRIPE_STARTER_ANNUAL_PRICE_ID=price_... # $490/yr
STRIPE_GROWTH_PRICE_ID=price_...  # $99/mo - 30 reps
STRIPE_GROWTH_ANNUAL_PRICE_ID=price_...  # $990/yr
STRIPE_PRO_PRICE_ID=price_...     # $249/mo - 100 reps
STRIPE_PRO_ANNUAL_PRICE_ID=price_...     # $2490/yr

SENTRY_AUTH_TOKEN=