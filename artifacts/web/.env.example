# ─── API ──────────────────────────────────────────────────────────────────────
# URL of the backend API (no trailing slash)
# Development: http://localhost:8088
# Production:  https://api.yourdomain.com
VITE_API_URL=http://localhost:8088

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Must match BETTER_AUTH_URL in the API .env
VITE_BETTER_AUTH_URL=http://localhost:8088

# ─── Stripe ───────────────────────────────────────────────────────────────────
VITE_STRIPE_STARTER_PRICE_ID=price_... # $49/mo - 10 reps
VITE_STRIPE_STARTER_ANNUAL_PRICE_ID=price_... # $490/yr
VITE_STRIPE_GROWTH_PRICE_ID=price_...  # $99/mo - 30 reps
VITE_STRIPE_GROWTH_ANNUAL_PRICE_ID=price_...  # $990/yr
VITE_STRIPE_PRO_PRICE_ID=price_...     # $249/mo - 100 reps
VITE_STRIPE_PRO_ANNUAL_PRICE_ID=price_...     # $2490/yr
VITE_STRIPE_EXTRA_REPS_PRICE_ID=price_... # $8/rep/mo
VITE_STRIPE_YEARLY_EXTRA_REPS_PRICE_ID=price_... # $80/rep/yr
