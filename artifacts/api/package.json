{
  "name": "@workspace/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development bun --watch src/index.ts",
    "build": "bun build ./src/index.ts --outdir ./dist --target node --sourcemap=external",
    "start": "NODE_ENV=production bun ./dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@better-auth/infra": "^0.2.6",
    "@better-auth/mongo-adapter": "^1.6.9",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/queue": "workspace:*",
    "@workspace/email-templates": "workspace:*",
    "better-auth": "^1.6.9",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "mongodb": "^6.13.0",
    "bson": "6.10.1",
    "mongoose": "8.12.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "safe-buffer": "^5.2.1",
    "stripe": "^22.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.0",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0"
  }
}
