# ─── Server ───────────────────────────────────────────────────────────────────
PORT=8088

# ─── Auth ─────────────────────────────────────────────────────────────────────
SESSION_SECRET=""
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:8088"

# Comma-separated list of allowed frontend origins (CORS)
ALLOWED_ORIGINS=http://localhost:3000

# ─── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=""
# Get this from: stripe listen --forward-to localhost:8088/api/billing/webhook
# In production: add webhook in Stripe Dashboard → Developers → Webhooks
STRIPE_WEBHOOK_SECRET=""

# ─── App URL (used in email links) ────────────────────────────────────────────
# Set this to your production frontend URL in deployment
APP_URL=http://localhost:3000

# ─── Database ─────────────────────────────────────────────────────────────────
MONGO_URL=""


# ─── Redis (BullMQ email queue) ───────────────────────────────────────────────
# Local dev:   redis://localhost:6379
# Upstash:     rediss://:<token>@<host>:6380
# Redis Cloud: redis://:<password>@<host>:<port>
REDIS_URL=redis://localhost:6379

# Set to "true" to enable TLS (automatically enabled when NODE_ENV=production)
REDIS_TLS=false

# ─── SMTP (email delivery) ────────────────────────────────────────────────────
# Works with any SMTP-compatible provider.
#
# Postmark:
#   SMTP_HOST=smtp.postmarkapp.com  SMTP_PORT=587  SMTP_USER=<SERVER_TOKEN>  SMTP_PASS=<SERVER_TOKEN>
#
# Resend:
#   SMTP_HOST=smtp.resend.com  SMTP_PORT=465  SMTP_SECURE=true  SMTP_USER=resend  SMTP_PASS=<API_KEY>
#
# Mailgun:
#   SMTP_HOST=smtp.mailgun.org  SMTP_PORT=587  SMTP_USER=<SMTP_LOGIN>  SMTP_PASS=<SMTP_PASSWORD>
#
# Gmail (app password required):
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_USER=you@gmail.com  SMTP_PASS=<APP_PASSWORD>
SMTP_HOST=
SMTP_PORT=587
# Set to "true" for port 465 (implicit TLS); leave "false" for STARTTLS (port 587)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# From address shown to recipients
MAIL_FROM="CommissionKit <noreply@commissionkit.io>"
