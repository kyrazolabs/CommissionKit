{
  "$schema": "https://biomejs.dev/schemas/2.5.8/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "artifacts/**",
      "lib/**",
      "plugins/**",
      "scripts/**",
      "test/**",
      "*.json",
      "*.jsonc",
      "*.ts",
      "*.tsx",
      "*.js",
      "*.mjs",
      "*.cjs",
      "!**/*.css",
      "!**/node_modules",
      "!**/.next",
      "!**/dist",
      "!**/build",
      "!**/generated",
      "!**/coverage"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "linter": {
    "enabled": true,
    "rules": {
      "a11y": {
        "useButtonType": "warn",
        "noSvgWithoutTitle": "warn",
        "useSemanticElements": "warn",
        "noStaticElementInteractions": "warn",
        "useKeyWithClickEvents": "warn",
        "useFocusableInteractive": "warn",
        "useAriaPropsForRole": "warn",
        "noRedundantRoles": "warn",
        "noLabelWithoutControl": "warn",
        "noAutofocus": "warn",
        "useAriaPropsSupportedByRole": "warn",
        "noAmbiguousAnchorText": "warn",
        "useValidAnchor": "warn"
      },
      "suspicious": {
        "noExplicitAny": "warn",
        "useIterableCallbackReturn": "warn"
      },
      "correctness": {
        "noUnusedVariables": "warn",
        "noUnusedImports": "warn"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "artifacts/api/src/**",
        "artifacts/web/src/**",
        "artifacts/blog/src/**",
        "lib/**/src/**",
        "plugins/**/src/**"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": {
              "level": "error",
              "options": {
                "allow": [
                  "assert",
                  "count",
                  "debug",
                  "dir",
                  "error",
                  "group",
                  "groupEnd",
                  "info",
                  "table",
                  "time",
                  "timeEnd",
                  "trace",
                  "warn"
                ]
              }
            }
          }
        }
      }
    }
  ],
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "jsxQuoteStyle": "double"
    }
  }
}
